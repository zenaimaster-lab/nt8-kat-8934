<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile gate for the NinjaScript indicator sources, including canonical A1 source.
    NT8 compiles these inside NinjaTrader with .NET Framework 4.8 Roslyn;
    this project reproduces that locally. Run:  dotnet build tools/CompileCheck
    Reference assemblies come from NuGet (no admin / no VS required).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- CS0436 duplicate type vs NinjaTrader.Custom.dll is expected: local source wins -->
    <NoWarn>0436;0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Kat34Scalper.cs" />
    <Compile Include="..\..\src\*.cs" />
    <!-- Independent sibling repos (not submodules): canonical A1 + StackEMA sources. -->
    <Compile Include="..\..\..\nt8-kat-A1-TradeBackground\Kat34Scalper.AlertSignal.A1.cs" />
    <Compile Include="..\..\..\nt8-kat-StackEMA\nt8-kat-StackEMA.cs" />
    <Compile Include="..\..\..\nt8-kat-StackEMA\StackEmaLogic.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="NinjaTrader.Core">
      <HintPath>C:\Program Files\NinjaTrader 8\bin\NinjaTrader.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NinjaTrader.Gui">
      <HintPath>C:\Program Files\NinjaTrader 8\bin\NinjaTrader.Gui.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Compiled NT8 built-ins (EMA, Brushes, Draw helpers). CS0436 type-conflict warnings vs local sources are expected: source wins. -->
    <Reference Include="NinjaTrader.Custom">
      <HintPath>$(USERPROFILE)\Documents\NinjaTrader 8\bin\Custom\NinjaTrader.Custom.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
